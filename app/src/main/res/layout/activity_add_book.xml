<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <EditText android:id="@+id/edtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tên sách" />
        <EditText android:id="@+id/edtAuthor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tác giả" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thể loại" android:layout_marginTop="10dp"/>
        <Spinner android:id="@+id/spinnerGenre" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tình trạng đọc" android:layout_marginTop="10dp"/>
        <RadioGroup android:id="@+id/rgStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbUnread" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chưa đọc" android:checked="true"/>
            <RadioButton android:id="@+id/rbReading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang đọc"/>
            <RadioButton android:id="@+id/rbRead" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã đọc"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đánh giá" android:layout_marginTop="10dp"/>
        <RatingBar android:id="@+id/rbRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:numStars="5" android:stepSize="1.0" />

        <EditText android:id="@+id/edtNote" android:layout_width="match_parent" android:layout_height="100dp" android:hint="Ghi chú..." android:inputType="textMultiLine" android:gravity="top|start"/>

        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lưu sách" android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>