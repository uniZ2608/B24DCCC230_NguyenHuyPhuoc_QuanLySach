<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#00796B" android:padding="10dp">
        <TextView android:id="@+id/tvTotal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF" android:text="Tổng: 0"/>
        <TextView android:id="@+id/tvRead" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF" android:text="Đã đọc: 0"/>
        <TextView android:id="@+id/tvUnread" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF" android:text="Chưa đọc xong: 0"/>
    </LinearLayout>

    <ListView android:id="@+id/lvBooks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"/>

    <Button android:id="@+id/btnAddBook" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Thêm sách" />
</LinearLayout>